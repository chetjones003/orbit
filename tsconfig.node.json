{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "tests/unit/main/**/*.ts",
    "tests/unit/shared/**/*.ts",
    "tests/unit/fakes/**/*.ts",
    "tests/fakes/**/*.ts",
    "tests/integration/**/*.ts",
    "scripts/**/*.mjs",
    "*.config.ts",
    "electron.vite.config.ts",
    "tests/e2e/**/*.ts"
  ]
}

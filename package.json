{
  "name": "orbit",
  "version": "0.5.3",
  "description": "Orbit: a desktop GitHub issue and PR client for personal repos",
  "private": true,
  "author": "Chet Jones",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build --config vite.config.ts",
    "tauri": "tauri",
    "package": "tauri build",
    "start": "tauri dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "fake-github": "node scripts/fake-github/server.mjs",
    "fake-dev": "node scripts/fake-github/launch.mjs",
    "fake-check": "node scripts/fake-github/check-dev.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/markdown": "1.8.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/api": "2.12.5",
    "@ui-sdk/core": "0.1.0-beta.3",
    "@ui-sdk/react": "0.1.0-beta.3",
    "daisyui": "5.8.0",
    "dompurify": "3.4.18",
    "mermaid": "11.17.2",
    "react": "19.1.10",
    "react-diff-view": "3.3.3",
    "react-dom": "19.1.10",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.12.5",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "sharp": "0.34.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}

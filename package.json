{
  "name": "orbit",
  "version": "0.4.0",
  "description": "Orbit: a desktop GitHub issue and PR client for personal repos",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Chet Jones",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "24.11.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "fake-github": "node scripts/fake-github/server.mjs",
    "fake-app": "electron-vite build && node scripts/fake-github/launch.mjs",
    "fake-assets": "node scripts/fake-github/make-assets.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/markdown": "1.8.1",
    "@tailwindcss/vite": "4.3.5",
    "daisyui": "5.8.0",
    "dompurify": "3.4.18",
    "electron-updater": "6.8.11",
    "electron-vite": "6.0.0",
    "mermaid": "11.17.2",
    "react": "19.1.10",
    "react-diff-view": "3.3.3",
    "react-dom": "19.1.10",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.10",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "sharp": "0.34.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "electron@45.3.2": true
  }
}
